{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "libri-presentes",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-01",

  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "libri-presentes-db",
      "database_id": "COLE_O_DATABASE_ID_AQUI",
      "migrations_dir": "./migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "libri-presentes"
    }
  ],

  "vars": {
    "APP_NAME": "Libri Presentes",
    "APP_URL": "https://presentes.libriconvites.com.br",
    "APP_TIMEZONE": "America/Sao_Paulo",
    "MAX_UPLOAD_BYTES": "10485760",
    "IMAGE_MAX_LONG_EDGE": "800",
    "IMAGE_TARGET_BYTES": "81920",
    "RESERVATION_HOURS": "48"
  },

  "observability": {
    "enabled": true
  }
}
