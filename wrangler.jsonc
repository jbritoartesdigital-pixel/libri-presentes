{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "libri-presentes",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/e/*",
      "/preview/*",
      "/c/*",
      "/r/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "libri-presentes-db",
      "database_id": "c8e4cfa6-2071-4b5e-b33c-bb50456054b7",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "libri-presentes"
    }
  ],
  "vars": {
    "APP_NAME": "Libri Presentes",
    "APP_URL": "https://presentes.libriconvites.com.br",
    "APP_TIMEZONE": "America/Sao_Paulo",
    "MAX_UPLOAD_BYTES": "307200",
    "RESERVATION_HOURS": "48"
  },
  "observability": { "enabled": true }
}